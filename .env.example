# ResearchForge AI - Environment Configuration Example

# Google Gemini API Key (for Live LLM Query Builder & Thesis Milestone Synthesis)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Supabase PostgreSQL & Auth Credentials
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (Optional for production distributed rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
